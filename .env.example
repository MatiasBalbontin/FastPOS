# =============================================================
# VARIABLES DE ENTORNO — FASTPOS (cliente local)
# =============================================================
# Copia este archivo a ".env" para configurar el sistema.
# En producción este .env lo genera automáticamente el servidor
# en el primer arranque (ver server/server.ts).
# =============================================================


# -------------------------------------------------------------
# INFORMACIÓN DE LA EMPRESA (opcional — se puede configurar
# desde la interfaz de FastPOS después de activar)
# -------------------------------------------------------------
COMPANY_NAME=""
COMPANY_RUT=""
COMPANY_ADDRESS=""
COMPANY_PHONE=""
COMPANY_EMAIL=""
COMPANY_BANK_DETAILS=""


# -------------------------------------------------------------
# AUTENTICACIÓN Y SEGURIDAD (generados automáticamente en el
# primer arranque si no existen — NO cambiar después de crear
# la primera cuenta de administrador)
# -------------------------------------------------------------
ADMIN_PASSWORD=""
SESSION_SECRET=""


# -------------------------------------------------------------
# SERVIDOR DE LICENCIAS EN LA NUBE
# Después de desplegar servidor-licencias/ en Vercel, pega aquí
# la URL que Vercel te asigna.
# Formato: https://TU-PROYECTO.vercel.app
# (sin barra al final)
# -------------------------------------------------------------
LICENSE_SERVER_URL=PEGAR_AQUI_LA_URL_DE_VERCEL


# -------------------------------------------------------------
# HMAC_SECRET — Clave compartida para verificar licencias offline
# DEBE ser EXACTAMENTE la misma que configuraste en el servidor
# de licencias (servidor-licencias/.env → HMAC_SECRET).
# Si difieren, FastPOS rechazará todas las licencias activadas.
# -------------------------------------------------------------
HMAC_SECRET=PEGAR_AQUI_LA_MISMA_CLAVE_HMAC_DEL_SERVIDOR
